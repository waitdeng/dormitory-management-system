# ---- Runtime environment (copy to .env and fill in real values) ----
# NEVER commit the real .env file.

APP_ENV=development
APP_NAME="DMS Backend"
DEBUG=false
LOG_LEVEL=INFO

# ---- MySQL ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=dms
MYSQL_USER=dms_user
MYSQL_PASSWORD=change-me
# Root password is only used by the MySQL container bootstrap
MYSQL_ROOT_PASSWORD=change-me-root

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- CORS ----
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# ---- Bootstrap admin (used once by `python -m app.seed`) ----
DMS_ADMIN_USERNAME=admin
DMS_ADMIN_PASSWORD=change-me-admin
DMS_ADMIN_DISPLAY_NAME=Super Administrator

# ---- Docker Compose ----
WEB_PORT=8080
