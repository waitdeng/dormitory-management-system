# ---- Runtime environment (copy to .env and fill in real values) ----
# NEVER commit the real .env file.

APP_ENV=development

# ---- MySQL (used by Docker Compose) ----
MYSQL_DATABASE=dms
MYSQL_USER=dms_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# ---- Backend security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string

# ---- Room door access code encryption (FEAT-008) ----
# Dedicated Fernet key, SEPARATE from SECRET_KEY (JWT).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, a key is derived from SECRET_KEY (backward compatible, not recommended).
ACCESS_CODE_ENCRYPTION_KEY=
# Optional decrypt-only legacy secrets (comma-separated).
# Use SECRET_KEY to keep reading codes encrypted before key separation.
# Rotate: set the old secret here, set the new key above, then call
# POST /api/v1/rooms/access-code/rotate (admin). Never log plaintext codes.
ACCESS_CODE_LEGACY_SECRETS=

# ---- Bootstrap admin ----
DMS_ADMIN_USERNAME=admin
DMS_ADMIN_PASSWORD=change-me-admin
DMS_ADMIN_DISPLAY_NAME=Super Administrator

# ---- Ports ----
WEB_PORT=8080

# ---- Backend docs & background scanner ----
# /api/docs is hidden when APP_ENV=production unless ENABLE_API_DOCS=true.
# Non-production APP_ENV always serves docs.
ENABLE_API_DOCS=false
# SCANNER_ENABLED=true
# SCANNER_INTERVAL_SECONDS=60

# ---- Optional: Redis cache profile ----
# docker compose --profile cache up
