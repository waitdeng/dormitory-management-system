# ---- Runtime environment (copy to .env and fill in real values) ----
# NEVER commit the real .env file.

APP_ENV=development

# ---- MySQL (used by Docker Compose) ----
MYSQL_DATABASE=dms
MYSQL_USER=dms_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# ---- Backend security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string

# ---- Bootstrap admin ----
DMS_ADMIN_USERNAME=admin
DMS_ADMIN_PASSWORD=change-me-admin
DMS_ADMIN_DISPLAY_NAME=Super Administrator

# ---- Ports ----
WEB_PORT=8080

# ---- Backend docs & background scanner ----
# /api/docs is hidden when APP_ENV=production unless ENABLE_API_DOCS=true.
# Non-production APP_ENV always serves docs.
ENABLE_API_DOCS=false
# SCANNER_ENABLED=true
# SCANNER_INTERVAL_SECONDS=60

# ---- Optional: Redis cache profile ----
# docker compose --profile cache up
